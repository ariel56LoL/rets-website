{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "rets-website",
  "main": "worker.js",

  "compatibility_date": "2026-09-29",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rets-testers",
      "database_id": "2c33a2b8-0bba-4ed9-86c1-5a7600d9488e"
    }
  ]
}
